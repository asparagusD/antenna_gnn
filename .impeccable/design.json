 "narrative": {
  "northStar": "The board you would etch.",
  "overview": "GraphPatch draws an antenna the way an RF engineer meets it on the bench: flat copper on microwave laminate, dimensioned like a fabrication drawing. The pixel editor is the board; the |S11| plot and the results read beside it in silkscreen-white type. The world lends four things only: palette, type, density and one signature move. Layout, navigation and controls stay the standard ones of an engineering web tool.\n\nEverything is flat. Copper is a solid colour, not a metal effect; the substrate is a field, not a texture. Precision comes from alignment, tabular numbers and hairline rules.",
  "keyCharacteristics": [
   "Copper on laminate, strictly flat; dark laminate by default, cool white PTFE laminate in the light theme.",
   "Live copper (signature move): copper connected to the feed reads full copper; floating islands read duller with a dashed edge, live as you paint.",
   "Silkscreen dimension lines around the board (32.4 mm, pixel pitch).",
   "One sans family with tabular numerals for every number.",
   "Colour does one job per role: copper = metal, action = pressable, threshold red = the −10 dB line, caution amber = fill outside 30–80%."
  ],
  "rules": [
   {
    "name": "The One Job Rule",
    "body": "Every accent has exactly one job. Red never marks errors, emphasis or decoration; action never colours data; copper never colours chrome.",
    "section": "colors"
   },
   {
    "name": "The Not-Colour-Alone Rule",
    "body": "Seed pixels are hatched copper, metal is solid, air is bare substrate; floating copper carries a dashed edge; the scope notice and fill warning always carry words.",
    "section": "colors"
   },
   {
    "name": "The Tabular Rule",
    "body": "Every number on screen, in every size, uses tabular figures.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do keep copper flat: one solid colour per state.",
   "Do keep an out-of-scope curve on screen and annotate it in place.",
   "Do give every state words as well as colour.",
   "Do use tabular figures for every number."
  ],
  "donts": [
   "Don't add PCB costume: solder-mask texture, vias, gold plating, copper sheen or gradients.",
   "Don't use red for anything but the −10 dB line.",
   "Don't use modals for routine states or spinners over the curve.",
   "Don't let the world supply layout or controls; they stay standard web components."
  ]
 }
}
